# ---- Hedera (required) ----
# Free testnet account: https://portal.hedera.com (choose ECDSA). This account acts as the trust authority.
OPERATOR_ID=0.0.xxxxxx
OPERATOR_KEY=paste-your-private-key-here
OPERATOR_KEY_TYPE=ECDSA
HEDERA_NETWORK=testnet
AUTHORITY_NAME=Autorité de confiance Sahih

# ---- Authority login (console /authority.html) ----
# If AUTHORITY_PASSWORD is empty, a password is generated and printed ONCE in the console at first start.
AUTHORITY_EMAIL=autorite@sahih.tn
AUTHORITY_PASSWORD=
# Optional: 32+ random characters used to sign sessions and encrypt institution keys (default: data/secret.key)
SESSION_SECRET=

# ---- AI explanations (optional) ----
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=

# ---- Telegram bot (optional) ----
# Create a bot with @BotFather and paste its token
TELEGRAM_BOT_TOKEN=

PORT=3000
# Optional: public URL put inside QR codes (e.g. http://192.168.1.20:3000)
PUBLIC_URL=
